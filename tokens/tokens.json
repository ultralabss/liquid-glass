{
  "$description": "UltraLabs Glass design tokens. Single source of truth. Run `node scripts/build-tokens.mjs` to regenerate tokens.css. Every key becomes --ul-<path-joined-by-dashes>; 6-digit hex colors also emit an -rgb triplet; spring.* emits --ul-ease-<name> as CSS linear() plus --ul-ease-<name>-settle. A key named DEFAULT maps to the group name itself (elasticity.DEFAULT → --ul-elasticity). $themes.<name>.tokens override values under [data-ul-theme=\"<name>\"]; app is the default.",
  "color": {
    "graphite": "#0b0d12",
    "graphite-2": "#11141b",
    "graphite-3": "#181c25",
    "steel": "#3a4250",
    "steel-2": "#5b6577",
    "silver": "#c7cfdb",
    "silver-hi": "#eef2f8",
    "ice": "#8fb8ff",
    "violet": "#a48cff",
    "white": "#ffffff",
    "text": "#f3f6fb",
    "text-2": "#c3cbd8",
    "text-3": "#8e98aa",
    "danger": "#ff6b7d",
    "success": "#5fe0a6",
    "warning": "#ffc46b",
    "shadow": "#04060d",
    "surface-solid": "#171b24",
    "ink": "#0b0d12"
  },
  "radius": {
    "xs": "6px",
    "sm": "10px",
    "md": "14px",
    "lg": "22px",
    "xl": "28px",
    "2xl": "36px",
    "capsule": "9999px"
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "blur": {
    "sm": "0px",
    "md": "2px",
    "lg": "4px",
    "xl": "4px"
  },
  "tint": {
    "subtle": 0.04,
    "regular": 0.05,
    "strong": 0.07,
    "flat": 0.06
  },
  "glass": {
    "saturate": "140%",
    "brightness": "1.04",
    "sm": {
      "blur": "var(--ul-blur-sm)",
      "refraction": 60,
      "bezel": "24px",
      "aberration": 2,
      "tint": "var(--ul-tint-regular)",
      "radius": "var(--ul-radius-capsule)",
      "shadow": "0 1px 1px rgb(var(--ul-color-shadow-rgb) / .28), 0 4px 12px -2px rgb(var(--ul-color-shadow-rgb) / .34)"
    },
    "md": {
      "blur": "var(--ul-blur-md)",
      "refraction": 70,
      "bezel": "var(--ul-bezel-width)",
      "aberration": 2,
      "tint": "var(--ul-tint-subtle)",
      "radius": "var(--ul-radius-lg)",
      "shadow": "0 1px 2px rgb(var(--ul-color-shadow-rgb) / .3), 0 8px 24px -6px rgb(var(--ul-color-shadow-rgb) / .42), 0 20px 40px -20px rgb(var(--ul-color-shadow-rgb) / .36)"
    },
    "lg": {
      "blur": "var(--ul-blur-lg)",
      "refraction": 76,
      "bezel": "36px",
      "aberration": 2,
      "tint": "var(--ul-tint-regular)",
      "radius": "var(--ul-radius-xl)",
      "shadow": "0 2px 4px rgb(var(--ul-color-shadow-rgb) / .3), 0 16px 40px -10px rgb(var(--ul-color-shadow-rgb) / .5), 0 36px 80px -30px rgb(var(--ul-color-shadow-rgb) / .46)"
    },
    "xl": {
      "blur": "var(--ul-blur-xl)",
      "refraction": 84,
      "bezel": "40px",
      "aberration": 2.2,
      "tint": "var(--ul-tint-strong)",
      "radius": "var(--ul-radius-2xl)",
      "shadow": "0 2px 6px rgb(var(--ul-color-shadow-rgb) / .32), 0 24px 64px -12px rgb(var(--ul-color-shadow-rgb) / .56), 0 60px 120px -40px rgb(var(--ul-color-shadow-rgb) / .5)"
    },
    "light": {
      "size": "260px",
      "intensity": 0.16,
      "proximity": 140,
      "max": 4
    },
    "magnify": 1.04,
    "bezel-max-ratio": 0.35,
    "small-edge-shift": 8,
    "flare": {
      "size": "140px",
      "intensity": 0.38
    },
    "fringe-w": "1.5px",
    "fringe": ".05"
  },
  "mobile": {
    "$description": "Mobile glass policy (touch, ≤ 1024px). refraction-scale multiplies every lens; surfaces larger than refraction-max-area (CSS px², about 200×200) use the blur fallback, because the SVG filter cost grows with area × DPR². fallback-* strengthen the blur-only look (iOS / WebKit never refracts).",
    "refraction-scale": 0.5,
    "refraction-max-area": 40000,
    "fallback-tint": 0.04,
    "fallback-rim": 0.22
  },
  "perf": {
    "$description": "Glass performance governor. refraction-area (px²): refracted area allowed per viewport, plus refraction-max-count. Priority: overlay > focused/hovered > island > small controls (< small-area px²) closest to the viewport center > everything else, so big surfaces drop to lite first. Overlays and hovered/focused surfaces are always full and count toward the cap only. The governor shrinks the area 25 % per second while p95 frame time exceeds frame-budget (ms) and drops aberration to 1 pass; restores after 3 s stable. aberration-min-area (px²): 3-pass aberration on full surfaces at least this big (and on hovered small controls). size-bucket / size-bucket-small (px): maps and filters are shared per quantized size; small surfaces use exact sizes. promote-max-area (px²): bigger containers are not promoted on hover. demote-delay / crossfade (ms): hover promotion timing. offscreen-margin (px): surfaces farther outside the viewport go flat. lite-*: the lite look (CSS colorize strength, tint, desaturate, rim hairline, bevel size). ambient-max-glass / ambient-idle: animated backgrounds pause above this many visible glass surfaces or after this long without input.",
    "refraction-area": 150000,
    "refraction-max-count": 30,
    "small-area": 16000,
    "size-bucket-small": 1,
    "frame-budget": 18,
    "aberration-min-area": 16000,
    "size-bucket": 4,
    "promote-max-area": 160000,
    "demote-delay": 400,
    "crossfade": 320,
    "offscreen-margin": 200,
    "lite-tint": 0.02,
    "lite-colorize": 0.3,
    "lite-desaturate": 1,
    "lite-rim": 0.18,
    "lite-edge": "8px",
    "ambient-max-glass": 12,
    "ambient-idle": 3000
  },
  "font": {
    "sans": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro Text\", Inter, system-ui, sans-serif",
    "mono": "\"SF Mono\", ui-monospace, \"JetBrains Mono\", Menlo, monospace"
  },
  "text": {
    "xs": "11px",
    "sm": "13px",
    "md": "15px",
    "lg": "17px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "32px",
    "4xl": "48px"
  },
  "weight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "duration": {
    "fast": "180ms",
    "base": "320ms",
    "slow": "520ms"
  },
  "spring": {
    "bouncy": {
      "stiffness": 220,
      "damping": 14,
      "mass": 1
    },
    "smooth": {
      "stiffness": 170,
      "damping": 26,
      "mass": 1
    },
    "snappy": {
      "stiffness": 380,
      "damping": 30,
      "mass": 1
    }
  },
  "ease": {
    "standard": "cubic-bezier(.2, .8, .2, 1)",
    "spring": "cubic-bezier(.3, 1.4, .5, 1)"
  },
  "focus": {
    "ring": "0 0 0 2px var(--ul-color-graphite), 0 0 0 4px var(--ul-color-ice)",
    "color": "color-mix(in srgb, var(--ul-accent) 70%, var(--ul-color-white))",
    "width": "2px",
    "offset": "2px"
  },
  "bezel": {
    "width": "32px"
  },
  "elasticity": {
    "DEFAULT": 0.6,
    "sm": 1,
    "md": 0.4,
    "lg": 0,
    "xl": 0
  },
  "pop": {
    "enter-duration": "500ms",
    "exit-duration": "350ms",
    "overshoot": 0.05,
    "stretch": 0.06,
    "goo": 1,
    "stagger": "30ms",
    "offset": "8px",
    "scrim": 0.55,
    "goo-opacity": 0.22,
    "lag": "50ms"
  },
  "z": {
    "overlay": 1000,
    "veil": "calc(var(--ul-z-overlay) - 1)"
